# Athena++ (Kokkos version) input file for 3d isothermal circumbinary disk 

<comment>
problem   = cbdiso_3d

<job>
basename  = CBD      # problem ID: basename of output filenames

<mesh>
nghost    = 3          # Number of ghost cells
nx1       = 300        # Number of zones in X1-direction
x1min     = -3.0       # minimum value of X1
x1max     =  3.0       # maximum value of X1
ix1_bc    = outflow    # inner-X1 boundary flag
ox1_bc    = outflow    # outer-X1 boundary flag

nx2       = 300        # Number of zones in X2-direction
x2min     = -3.0       # minimum value of X2
x2max     =  3.0       # maximum value of X2
ix2_bc    = outflow    # inner-X2 boundary flag
ox2_bc    = outflow    # outer-X2 boundary flag

nx3       = 40          # Number of zones in X3-direction
x3min     = -1.0       # minimum value of X3
x3max     =  1.0       # maximum value of X3
ix3_bc    = outflow    # inner-X3 boundary flag
ox3_bc    = outflow    # outer-X3 boundary flag

nmb1 = 2
nmb2 = 2
nmb3 = 2

<meshblock>
nx1       = 150         # Number of cells in each MeshBlock, X1-dir
nx2       = 150         # Number of cells in each MeshBlock, X2-dir
nx3       = 20          # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic    # dynamic/kinematic/static
integrator = rk2        # time integration algorithm
cfl_number = 0.2        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 10.0       # time limit
ndiag      = 1          # cycles between diagostic output

<hydro>
eos         = ideal     # EOS type
reconstruct = ppm4      # spatial reconstruction method
rsolver     = hllc      # Riemann-solver to be used
gamma       = 1.000001    # gamma = C_p/C_v

<problem>
a_binary     = 1.0    
q_mass       = 1.0
eccentricity = 0.0
r_soft       = 0.1
r_sink       = 0.1 
m_total      = 1.0
sink_rate    = 10.0
SinkModel    = 2
Mach         = 10.0
alpha        = 0.1
Orientation  = 0.0

eps            = 1e-10
floor_density  = 1e-10
floor_pressure = 1e-12

#<output1>
#file_type  = hst        # History data dump
#dt         = 0.01       # time increment between outputs

<output1>
file_type  = bin        # Binary data dump
variable   = hydro_w    # variables to be output
dt         = 0.1        # time increment between outputs
